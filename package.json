{
  "name": "alternance-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Suivi de recherche d'alternance : API Express + Sequelize + front intégré",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "tsx src/server.ts",
    "fixtures": "tsx src/db/fixtures/loadFixtures.ts",
    "import-linkedin": "tsx src/db/fixtures/importInteractions.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.17.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
