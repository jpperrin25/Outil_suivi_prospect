# Copier ce fichier en ".env" puis adapter les valeurs.
PORT=3000
NODE_ENV=development

# Obligatoire en production : une longue chaîne aléatoire
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Base de données ---
# mysql (défaut, avec Docker Compose) ou sqlite (un seul fichier ./data/alternance.db)
DB_DIALECT=mysql
# "safe" : crée les tables manquantes sans rien toucher (défaut)
# "alter": adapte les tables existantes au modèle après une évolution du code (les données sont conservées)
DB_SYNC=safe

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=alternance
DATABASE_USERNAME=alternance
DATABASE_PASSWORD=alternance_password
MYSQL_ROOT_PASSWORD=root_password

# Utilisé seulement si DB_DIALECT=sqlite
SQLITE_PATH=./data/alternance.db
